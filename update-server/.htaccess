# Sin listados de carpetas
Options -Indexes

# El APK debe bajarse como binario
<FilesMatch "\.apk$">
    ForceType application/vnd.android.package-archive
</FilesMatch>

# No servir como texto archivos sensibles (esquema, config, ini). Los .php SÍ se ejecutan.
<FilesMatch "\.(sql|ini|md|log)$">
    Require all denied
</FilesMatch>
<Files "config.php">
    # config.php solo se incluye desde otros scripts, nunca se abre directo.
    Require all denied
</Files>
