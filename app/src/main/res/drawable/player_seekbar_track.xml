<?xml version="1.0" encoding="utf-8"?>
<!-- Pista del seekbar del player: fondo casi invisible, línea de buffer (secondaryProgress)
     intermedia estilo YouTube, y progreso reproducido en blanco puro. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#26FFFFFF" />
            <size android:height="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="2dp" />
                <solid android:color="#33FFFFFF" />
                <size android:height="3dp" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="2dp" />
                <solid android:color="#FFFFFFFF" />
                <size android:height="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
