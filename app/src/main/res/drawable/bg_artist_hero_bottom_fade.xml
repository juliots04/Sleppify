<?xml version="1.0" encoding="utf-8"?>
<!-- Default bottom fade (used until the Palette dominant color is applied): the artist photo
     stays clear through the top, then fades into surface_dark so the name/list blend in.
     No centerColor on purpose — the fade spans the WHOLE scrim view height instead of only
     its lower half, matching the runtime Palette gradient. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#00111319"
        android:endColor="#FF111319"
        android:type="linear" />
</shape>
