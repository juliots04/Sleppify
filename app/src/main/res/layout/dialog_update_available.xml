<?xml version="1.0" encoding="utf-8"?>
<!-- Ventana emergente de nueva versión: negro puro, título con emoji + pastilla de versión,
     novedades y acción única. Actualización obligatoria: no tiene "Ahora no" y el diálogo no
     se puede cerrar tocando fuera ni con el botón atrás (ver MainActivity.showUpdateAvailablePopup). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_update_card"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="24dp">

    <!-- Fila título -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvUpdateDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="🔥 NUEVA VERSIÓN DISPONIBLE"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUpdateDialogPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_version_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="1.2"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:background="#FF232323" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.1"
        android:text="NOVEDADES"
        android:textColor="#FF8A8A8A"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvUpdateDialogNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="7dp"
        android:textColor="#FFEDEDED"
        android:textSize="14sp" />

    <!-- Acción / progreso in-situ. La actualización es obligatoria: la única salida es actualizar.
         El botón es compacto y va a la derecha (no acapara todo el ancho); al tocarlo se oculta y
         aparece la barra de descarga en su lugar (misma lógica que la antigua sección Actualizar). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">

        <!-- "Más tarde": solo visible en actualizaciones OPCIONALES (mandatory=false). Cierra el
             diálogo. En obligatorias queda GONE y la única salida es Actualizar. -->
        <TextView
            android:id="@+id/btnUpdateDialogLater"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Más tarde"
            android:textColor="#FF9A9A9A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnUpdateDialogGo"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:background="@drawable/bg_update_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:minWidth="132dp"
            android:paddingHorizontal="26dp"
            android:text="Actualizar"
            android:textColor="#FF000000"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Progreso de descarga (oculto hasta tocar Actualizar). -->
        <LinearLayout
            android:id="@+id/llUpdateDialogProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pbUpdateDialog"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="#33FFFFFF"
                android:progressTint="#FFFFFFFF" />

            <TextView
                android:id="@+id/tvUpdateDialogPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:gravity="end"
                android:minWidth="46dp"
                android:text="0%"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
