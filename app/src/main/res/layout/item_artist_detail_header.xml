<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_dark"
    android:orientation="vertical">

    <!-- Full-bleed hero: the artist photo fills the top of the screen with the name overlaid. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="430dp">

        <ImageView
            android:id="@+id/ivArtistBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface_high"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <!-- Bottom fade tinted at runtime with the artwork's dominant color (Palette). -->
        <View
            android:id="@+id/vArtistHeroTint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_artist_hero_bottom_fade" />

        <View
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_artist_hero_top_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tvArtistHeaderName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:text="Artista"
                android:textColor="#FFFFFFFF"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvArtistHeaderSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter_variable"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Action row: Follow + more on the left, Shuffle + big Play FAB on the right.
         Pulled up slightly so the Play FAB straddles the hero/list boundary (Spotify style). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/btnArtistFollow"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_artist_follow_pill"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="Seguir"
            android:textAllCaps="true"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/inter_variable"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnArtistMore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/text_secondary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnArtistShuffle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="10dp"
            android:src="@drawable/ic_player_shuffle"
            app:tint="@color/text_secondary" />

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginStart="10dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_artist_play_fab" />

            <ImageView
                android:id="@+id/btnArtistPlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="15dp"
                android:src="@drawable/ic_player_play"
                app:tint="@color/surface_dark" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvArtistPopularHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:paddingHorizontal="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:text="Popular"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
