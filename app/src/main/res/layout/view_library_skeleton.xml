<?xml version="1.0" encoding="utf-8"?>
<!-- Library loading skeleton: row placeholders that mimic the real Biblioteca list
     (item_music_result geometry). The real pinned header (title + filter chips) stays visible
     above the overlay, so the skeleton only needs the list — its top padding is set in code to the
     pinned header's height. The opaque surface_dark background is provided by the enclosing
     flLibraryLoadingOverlay FrameLayout; the shimmer sweep runs on the root. -->
<com.example.sleppify.widget.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llLibrarySkeletonContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp">

        <include layout="@layout/item_library_skeleton_row" />
        <include layout="@layout/item_library_skeleton_row" />
        <include layout="@layout/item_library_skeleton_row" />
        <include layout="@layout/item_library_skeleton_row" />
        <include layout="@layout/item_library_skeleton_row" />
        <include layout="@layout/item_library_skeleton_row" />
        <include layout="@layout/item_library_skeleton_row" />
        <include layout="@layout/item_library_skeleton_row" />
        <include layout="@layout/item_library_skeleton_row" />
    </LinearLayout>
</com.example.sleppify.widget.ShimmerFrameLayout>
