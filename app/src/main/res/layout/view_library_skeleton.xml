<?xml version="1.0" encoding="utf-8"?>
<!-- Library loading skeleton: a title + filter-chip placeholders followed by ~7 row placeholders
     that mimic the real Biblioteca list. The alpha of llLibrarySkeletonContent is pulsed by
     MusicPlayerFragment while shown. The opaque surface_dark background is provided by the
     enclosing flLibraryLoadingOverlay FrameLayout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llLibrarySkeletonContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- Title placeholder (mimics the "Biblioteca" header, cleared past the status bar) -->
    <View
        android:layout_width="150dp"
        android:layout_height="26dp"
        android:layout_marginTop="64dp"
        android:background="@drawable/bg_skeleton_block" />

    <!-- Filter chips placeholder -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <View
            android:layout_width="72dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="72dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="72dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="72dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_skeleton_block" />
    </LinearLayout>

    <!-- Spacer before the list -->
    <View
        android:layout_width="match_parent"
        android:layout_height="14dp" />

    <include layout="@layout/item_library_skeleton_row" />
    <include layout="@layout/item_library_skeleton_row" />
    <include layout="@layout/item_library_skeleton_row" />
    <include layout="@layout/item_library_skeleton_row" />
    <include layout="@layout/item_library_skeleton_row" />
    <include layout="@layout/item_library_skeleton_row" />
    <include layout="@layout/item_library_skeleton_row" />
</LinearLayout>
