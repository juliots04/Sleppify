<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="6dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRadio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        android:clickable="false"
        android:focusable="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Colored background forced to 1:1 -->
            <View
                android:id="@+id/vRadioBg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="#333333"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- The 3 overlapping circular thumbnails, pre-composed into a SINGLE cached image
                 (see RadioArtComposer) so the carousel never streams them in one by one. Drawn on a
                 transparent canvas so the vRadioBg gradient shows through the gaps. -->
            <ImageView
                android:id="@+id/ivRadioComposite"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitXY"
                android:contentDescription="@null"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toTopOf="@id/vRadioBg"
                app:layout_constraintBottom_toBottomOf="@id/vRadioBg"
                app:layout_constraintStart_toStartOf="@id/vRadioBg"
                app:layout_constraintEnd_toEndOf="@id/vRadioBg" />

            <!-- "RADIO" badge top-right -->
            <TextView
                android:id="@+id/tvRadioBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RADIO"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textFontWeight="900"
                android:fontFamily="@font/inter_variable"
                android:letterSpacing="0.15"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintTop_toTopOf="@id/vRadioBg"
                app:layout_constraintEnd_toEndOf="@id/vRadioBg" />

            <!-- Radio song title inside card, bottom -->
            <TextView
                android:id="@+id/tvRadioTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="10dp"
                android:singleLine="true"
                android:ellipsize="none"
                android:text="Canción"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                app:layout_constraintBottom_toBottomOf="@id/vRadioBg"
                app:layout_constraintStart_toStartOf="@id/vRadioBg"
                app:layout_constraintEnd_toEndOf="@id/vRadioBg" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Song name outside card, below image -->
    <TextView
        android:id="@+id/tvRadioName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="2dp"
        android:text="Radio de Canción"
        android:alpha="0.6"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter_variable"
        android:maxLines="2"
        android:ellipsize="end"
        android:includeFontPadding="false" />

</LinearLayout>
