<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRadio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        android:clickable="false"
        android:focusable="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Campo degradado 1:1 (RadioArtComposer.fieldDrawable, claro→oscuro del color
                 dominante). Placeholder mientras el composite se construye; el composite opaco lo
                 tapa 1:1 con los mismos colores, así el swap no salta. -->
            <View
                android:id="@+id/vRadioBg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="#3A3F46"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Diseño completo pre-compuesto en UNA imagen cacheada (RadioArtComposer, estilo
                 YT Music: degradado + barras de onda con picos + 3 círculos, el central al
                 frente). Sin chip de play, sin insignia RADIO ni título dentro de la tarjeta. -->
            <ImageView
                android:id="@+id/ivRadioComposite"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitXY"
                android:contentDescription="@null"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toTopOf="@id/vRadioBg"
                app:layout_constraintBottom_toBottomOf="@id/vRadioBg"
                app:layout_constraintStart_toStartOf="@id/vRadioBg"
                app:layout_constraintEnd_toEndOf="@id/vRadioBg" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Song name outside card, below image -->
    <TextView
        android:id="@+id/tvRadioName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="2dp"
        android:text="Radio de Canción"
        android:alpha="0.6"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter_variable"
        android:minLines="2"
        android:maxLines="2"
        android:ellipsize="end"
        android:includeFontPadding="false" />

</LinearLayout>
