<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-start skeleton for a home carousel section (Playlist recientes / Estaciones / Recomendadas).
     Mirrors the real structure 1:1: section header (16dp start, 20dp top / 10dp bottom rhythm, 18sp
     bold ≈ 18dp block) followed by a row of 46%-width square cards with the real 16dp corner radius
     (sized in code via skeletonCard1/2/3) and a 1-line name block below, like
     item_playlist_carousel / item_radio_carousel. The ShimmerFrameLayout root sweeps the
     YouTube-style highlight across the blocks (self-animating, all instances in sync). -->
<com.example.sleppify.widget.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="150dp"
            android:layout_height="18dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_skeleton_block" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="6dp">

                <View
                    android:id="@+id/skeletonCard1"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:background="@drawable/bg_skeleton_card" />

                <View
                    android:layout_width="118dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_skeleton_block" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="6dp">

                <View
                    android:id="@+id/skeletonCard2"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:background="@drawable/bg_skeleton_card" />

                <View
                    android:layout_width="98dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_skeleton_block" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="6dp">

                <View
                    android:id="@+id/skeletonCard3"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:background="@drawable/bg_skeleton_card" />

                <View
                    android:layout_width="126dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_skeleton_block" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.example.sleppify.widget.ShimmerFrameLayout>
