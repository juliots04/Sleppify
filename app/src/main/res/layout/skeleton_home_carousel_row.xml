<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-start placeholder for a horizontal carousel section (Playlist recientes / Estaciones).
     A title bar block + three square card blocks (each with a name-line block below), mirroring
     item_playlist_carousel / item_radio_carousel geometry. Card size is set to 46% of screen width
     in code (sizeHomeSkeletonCards) so the row's height matches the real carousel and swapping in
     the RecyclerView causes no layout jump. Reused for both rows via distinct <include> ids; the
     inner card ids are looked up scoped to each included container. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:importantForAccessibility="no">

    <View
        android:layout_width="200dp"
        android:layout_height="18dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_skeleton_block" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="6dp">

            <View
                android:id="@+id/skeletonCard1"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:background="@drawable/bg_skeleton_block" />

            <View
                android:layout_width="110dp"
                android:layout_height="13dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_skeleton_block" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="6dp">

            <View
                android:id="@+id/skeletonCard2"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:background="@drawable/bg_skeleton_block" />

            <View
                android:layout_width="90dp"
                android:layout_height="13dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_skeleton_block" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="6dp">

            <View
                android:id="@+id/skeletonCard3"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:background="@drawable/bg_skeleton_block" />

            <View
                android:layout_width="120dp"
                android:layout_height="13dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_skeleton_block" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
