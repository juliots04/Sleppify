<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="138dp"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingHorizontal="6dp"
    android:paddingVertical="6dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivArtistAlbumCover"
        android:layout_width="126dp"
        android:layout_height="126dp"
        android:background="@color/surface_high"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Sleppify.Rounded12" />

    <TextView
        android:id="@+id/tvArtistAlbumTitle"
        android:layout_width="126dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_variable"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvArtistAlbumSubtitle"
        android:layout_width="126dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:alpha="0.8"
        android:ellipsize="end"
        android:fontFamily="@font/inter_variable"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

</LinearLayout>
