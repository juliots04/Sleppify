<?xml version="1.0" encoding="utf-8"?>
<!-- Artist album card, matching the home-carousel design (item_playlist_carousel): the card is
     sized programmatically to 43% of the SHORT screen axis with 8dp start/end margins (see
     ArtistDetailFragment.AlbumAdapter.onCreateViewHolder), so the layout carries no fixed width
     or horizontal padding — the 1:1 cover equals the item width pixel-for-pixel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardArtistAlbum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivArtistAlbumCover"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/surface_high"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvArtistAlbumTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.6"
        android:ellipsize="end"
        android:fontFamily="@font/inter_variable"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:paddingTop="12dp"
        android:paddingBottom="2dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvArtistAlbumSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:alpha="0.8"
        android:ellipsize="end"
        android:fontFamily="@font/inter_variable"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

</LinearLayout>
