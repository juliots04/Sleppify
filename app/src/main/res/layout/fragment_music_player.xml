<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".MusicPlayerFragment">

    <!-- Pull-to-refresh wraps ONLY the scrollable content: the pinned header + chips carousel live
         OUTSIDE it, so a chip tap/swipe can never start a pull, and the SRL's scroll target is the
         real NestedScrollView (canChildScrollUp works: no pull while scrolled). -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeLibraryRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvLibraryContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <!-- FrameLayout: backdrop behind, content on top, both scroll together -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Backdrop image (fixed height, scrolls away) -->
            <ImageView
                android:id="@+id/ivLibraryBackdrop"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:alpha="0.40"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <!-- Fade: slightly taller than backdrop to cover transition zone -->
            <View
                android:id="@+id/vLibraryBackdropFade"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:background="@drawable/bg_library_backdrop_fade" />

            <!-- Content layer (overlaps backdrop) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- Reserves the pinned header's height (brand row + chips) at the top of the scroll
                 flow (synced to the header's measured height in code). -->
            <View
                android:id="@+id/vHeaderSpacer"
                android:layout_width="match_parent"
                android:layout_height="108dp" />

            <!-- Music state row (scrolls with content) -->
            <LinearLayout
                android:id="@+id/llMusicState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:background="@android:color/transparent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="0dp">

                <ProgressBar
                    android:id="@+id/progressMusic"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:indeterminateTint="@android:color/white"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvMusicState"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Featured result (scrolls with content) -->
            <LinearLayout
                android:id="@+id/llFeaturedResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="6dp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivFeaturedThumb"
                        android:layout_width="84dp"
                        android:layout_height="wrap_content"
                        android:minHeight="84dp"
                        android:background="@color/surface_high"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:maxHeight="84dp"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvFeaturedTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/manrope_variable"
                            android:maxLines="2"
                            android:text="CORA DE HIELO"
                            android:textAllCaps="true"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/tvFeaturedSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/inter_variable"
                            android:maxLines="1"
                            android:text="Canción • Artista"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFeaturedPlay"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_variable"
                        android:text="Reproducir"
                        android:textAllCaps="false"
                        android:textColor="#111319"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/white"
                        app:cornerRadius="23dp"
                        app:icon="@drawable/ic_player_play"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconTint="#111319" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFeaturedSave"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_variable"
                        android:text="Compartir"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="23dp"
                        app:icon="@android:drawable/ic_menu_share"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconTint="@color/text_primary"
                        app:rippleColor="#2FFFFFFF"
                        app:strokeColor="@color/surface_high"
                        app:strokeWidth="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Music results -->
            <LinearLayout
                android:id="@+id/llMusicBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <com.example.sleppify.widget.SafeRecyclerView
                    android:id="@+id/rvMusicResults"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.8"
                    android:clipToPadding="false"
                    android:paddingBottom="80dp"
                    android:nestedScrollingEnabled="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:descendantFocusability="afterDescendants"
                    tools:listitem="@layout/item_music_result" />
            </LinearLayout>

            </LinearLayout> <!-- end content layer -->
        </FrameLayout> <!-- end backdrop+content frame -->
    </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Empty state (overlay, centered): biblioteca vacía / sin sesión de YT Music. El botón se
         muestra solo sin sesión (updateYoutubeButtonLabel) como reintento manual del login. -->
    <LinearLayout
        android:id="@+id/llLibraryEmptyState"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivLibraryEmptyIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_music_translucent"
            android:layout_marginBottom="18dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvLibraryEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tu biblioteca está vacía"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold"
            android:fontFamily="@font/manrope_variable"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvLibraryEmptySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conecta tu cuenta de YouTube Music para ver aquí tus playlists, artistas y descargas."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:fontFamily="@font/inter_variable"
            android:textAlignment="center"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="22dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnYoutubeLogin"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:backgroundTint="@null"
            android:background="@drawable/bg_youtube_button"
            android:fontFamily="@font/inter_variable"
            android:paddingStart="22dp"
            android:paddingEnd="24dp"
            android:text="Continuar en YouTube Music"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:icon="@drawable/ic_yt_music_logo"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="24dp"
            app:iconTint="@null"
            app:rippleColor="#33FFFFFF" />
    </LinearLayout>

    <!-- Library loading state: a skeleton (placeholder rows) instead of a bare spinner. Reuses the
         existing show/dismiss/5s-timeout logic in MusicPlayerFragment (showLibraryGridOverlay /
         dismissLibraryGridOverlay). The inner llLibrarySkeletonContent alpha is pulsed while shown. -->
    <FrameLayout
        android:id="@+id/flLibraryLoadingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/surface_dark"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include layout="@layout/view_library_skeleton" />
    </FrameLayout>

    <!-- Status bar overlay: fades to solid on scroll -->
    <View
        android:id="@+id/vStatusBarOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        android:alpha="0"
        android:translationZ="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Single pinned library header: fixed AND floating at once, and the filter chips are part of
         it (the header reaches down to where the chips end). At the top it sits in its natural
         position (transparent, over the backdrop); scrolling down slides it out via translationY
         and scrolling up slides it back in (quick-return), turning solid while it floats over
         content. Driven by updateHeaderOnScroll(). Top padding = status bar inset (set in code). -->
    <LinearLayout
        android:id="@+id/llLibraryHeaderContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:translationZ="51dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Brand row -->
        <LinearLayout
            android:id="@+id/llFragBrandHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingTop="0dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tvFragBrandTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/ic_title_expand_circle"
                android:drawablePadding="4dp"
                android:gravity="start|center_vertical"
                android:minHeight="0dp"
                android:paddingEnd="10dp"
                android:paddingVertical="2dp"
                android:text="Biblioteca"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnFragHeaderHistory"
                android:layout_width="41.5dp"
                android:layout_height="41.5dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Historial"
                android:focusable="true"
                android:layout_marginEnd="4dp"
                android:padding="10dp"
                android:src="@drawable/ic_time_24"
                app:tint="@android:color/white" />

            <ImageView
                android:id="@+id/btnFragHeaderSearch"
                android:layout_width="41.5dp"
                android:layout_height="41.5dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Buscar"
                android:focusable="true"
                android:layout_marginEnd="8dp"
                android:padding="6dp"
                android:src="@drawable/ic_search"
                app:tint="@android:color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFragSignIn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/white"
                android:fontFamily="@font/inter_variable"
                android:text="Iniciar sesión"
                android:textAllCaps="false"
                android:textColor="#1F2B42"
                android:textSize="13sp"
                android:visibility="gone"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_google_logo"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="@null"
                app:rippleColor="#2200419E" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/btnFragProfilePhoto"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/header_action_settings"
                android:focusable="true"
                android:padding="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
        </LinearLayout>

        <!-- Library filter chips carousel (part of the pinned header) -->
        <HorizontalScrollView
            android:id="@+id/hsvLibraryChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipLibraryPlaylists"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_library_filter_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_variable"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Playlists"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipLibraryArtists"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_library_filter_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_variable"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Artistas"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipLibraryRadios"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_library_filter_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_variable"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Radios"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipLibraryDownloads"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_library_filter_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/inter_variable"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Descargas"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
