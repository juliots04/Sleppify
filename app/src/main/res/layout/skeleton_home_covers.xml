<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-start skeleton for the "Covers y remixes" section. Mirrors the real structure 1:1:
     section header at 16dp paddings (title 18sp block + "Reproducir todo" 12sp block at the end)
     followed by four track rows matching item_cover_track_row (50dp square thumb + title/subtitle
     lines at 8dp side padding — vpCovers pages have no extra horizontal padding). Wrapped in
     ShimmerFrameLayout for the sweeping highlight. -->
<com.example.sleppify.widget.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="22dp"
            android:paddingBottom="12dp">

            <View
                android:layout_width="140dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_skeleton_block" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <View
                android:layout_width="86dp"
                android:layout_height="12dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_skeleton_block" />
        </LinearLayout>

        <include layout="@layout/item_library_skeleton_row" />
        <include layout="@layout/item_library_skeleton_row" />
        <include layout="@layout/item_library_skeleton_row" />
        <include layout="@layout/item_library_skeleton_row" />
    </LinearLayout>
</com.example.sleppify.widget.ShimmerFrameLayout>
