<?xml version="1.0" encoding="utf-8"?>
<!-- One placeholder row, mimicking item_music_result.xml geometry (50dp thumb + 2 text lines).
     No android:id on the root so it can be <include>d multiple times without collisions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <View
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_skeleton_thumb" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <View
            android:layout_width="180dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_skeleton_block" />

        <View
            android:layout_width="120dp"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_skeleton_block" />
    </LinearLayout>
</LinearLayout>
